# 개발용: 각 레포의 main 최신을 가져온다
# 레포는 비공개 — SSH 키 또는 CI 토큰 필요 (README 참고)
repositories:
  core/demo_interfaces:
    type: git
    url: git@github.com:Juhyeong-Park/demo_interfaces.git
    version: main
  core/demo_localization:
    type: git
    url: git@github.com:Juhyeong-Park/demo_localization.git
    version: main
  core/demo_navigation:
    type: git
    url: git@github.com:Juhyeong-Park/demo_navigation.git
    version: main
  core/demo_safety:
    type: git
    url: git@github.com:Juhyeong-Park/demo_safety.git
    version: main
  core/demo_control:
    type: git
    url: git@github.com:Juhyeong-Park/demo_control.git
    version: main
  core/demo_bringup:
    type: git
    url: git@github.com:Juhyeong-Park/demo_bringup.git
    version: main
  third_party/demo_mathlib:
    type: git
    url: git@github.com:Juhyeong-Park/demo_mathlib.git
    version: main
